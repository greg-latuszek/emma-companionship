# ── Shared (copy to .env.local — gitignored) ───────────────────────────────
# Auth and app secrets live here. DB connection parts live in profile files.

# Optional defaults for db export/import scripts
SOURCE_PROFILE=development
TARGET_PROFILE=staging

NODE_ENV=development

# Auth.js v5 (Google OAuth)
# Generate AUTH_SECRET: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Dev bypass: skip Google OAuth when testing on LAN (never set in production)
# NEXT_PUBLIC_DEV_BYPASS_AUTH=true
# DEV_CD1_EMAIL=delegate1@example.com
# DEV_CD1_NAME=Delegate One
# DEV_CD2_EMAIL=delegate2@example.com
# DEV_CD2_NAME=Delegate Two

# Should we display hints on error pages for operator
OPERATOR_HINTS=1

# ── DB profiles (discrete parts — no DATABASE_URL) ─────────────────────────
# Create these gitignored files next to .env.local:
#   .env.development  — local Docker (Next loads this on `next dev`)
#   .env.staging      — import target / staging cloud DB
#   .env.production   — production cloud DB
#
# Canonical keys (same names in every profile):
#   DB_USER, DB_PASSWORD, DB_HOST, DB_PORT, DB_NAME
#   DB_NAME_TEST   — development only (test DB)
#   DB_SSL=false   — local Docker only; omit for cloud so the app uses SSL
#   DB_OPTIONS     — cloud query string, e.g. sslmode=require&channel_binding=require
#   DB_CONTAINER   — development only; docker container for pg_dump / psql

# Example .env.development:
# DB_USER=devuser
# DB_PASSWORD=devpassword
# DB_HOST=localhost
# DB_PORT=5433
# DB_NAME=emma_companionship_dev
# DB_NAME_TEST=emma_companionship_test
# DB_SSL=false
# DB_CONTAINER=emma_companionship_db

# Example .env.staging / .env.production:
# DB_USER=
# DB_PASSWORD=
# DB_HOST=
# DB_PORT=5432
# DB_NAME=
# DB_OPTIONS=sslmode=require&channel_binding=require
