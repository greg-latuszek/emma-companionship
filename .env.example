# Copy to .env.local (gitignored) and fill in real values.

# Local PostgreSQL (Docker: npm run db:start)
DB_USER=devuser
DB_PASSWORD=devpassword
DB_HOST=localhost
DB_PORT=5432
DB_NAME=emma_companionship_dev
DB_NAME_TEST=emma_companionship_test
DB_SSL=false
#for cloud PostgreSQL we should have no DB_SSL here to force SSL in app code

DATABASE_URL=postgresql://devuser:devpassword@localhost:5432/emma_companionship_dev
DATABASE_TEST_URL=postgresql://devuser:devpassword@localhost:5432/emma_companionship_test

# Auth.js v5 (Google OAuth)
# Generate AUTH_SECRET: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

NODE_ENV=development

# Dev bypass: skip Google OAuth when testing on LAN (never set in production)
# NEXT_PUBLIC_DEV_BYPASS_AUTH=true
# DEV_CD1_EMAIL=delegate1@example.com
# DEV_CD1_NAME=Delegate One
# DEV_CD2_EMAIL=delegate2@example.com
# DEV_CD2_NAME=Delegate Two

# Should we display hints on error pages for operator
# (should not be at production but allows testing even production variant)
OPERATOR_HINTS=1
