{
  "name": "emma-companionship",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit",
    "test": "vitest run src",
    "test:db": "vitest run db/tests",
    "test:watch": "vitest watch src",
    "db:start": "docker compose up -d postgres && sleep 2 && npm run db:create",
    "db:stop": "docker compose down",
    "db:create": "bash db/scripts/create-databases.sh",
    "db:migrate:dev": "bash db/migrate.sh ${npm_package_config_dbNameDev:-emma_companionship_dev}",
    "db:migrate:test": "bash db/migrate.sh ${npm_package_config_dbNameTest:-emma_companionship_test}",
    "db:psql": "docker exec -it emma_companionship_db psql -U devuser -d emma_companionship_dev",
    "db:reset": "npm run db:stop && npm run db:start",
    "db:logs": "docker compose logs -f postgres"
  },
  "dependencies": {
    "motion": "^13.2.0",
    "next": "16.3.4",
    "next-auth": "^5.0.0-beta.32",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "prettier": "^3.9.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^1.6.0"
  }
}
